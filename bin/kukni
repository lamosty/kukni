"""Kukni command-line launcher."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
from typing import Mapping


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT / "src"))

_MAKE_DEVELOPMENT_FILE = "KUKNI_MAKE_DEVELOPMENT_FILE"
_USAGE = """\
Usage: kukni [FILE]
       kukni --development [FILE]
       kukni --check
       kukni --check-html
       kukni --version

Preview FILE, or open an empty Kukni window when no file is supplied.

Options:
  --development  Run this source checkout without installing or registering it.
                 Development mode is isolated from the installed application
                 and never provides Nautilus previewer integration.
  --check        Check this runtime without requiring a display.
  --check-html   Verify WebKit pixels; requires a display and briefly opens a
                 window containing only the fixed synthetic test page.
  --version      Show the running checkout or installed package revision.
  -h, --help     Show this help.

Security sandboxes remain mandatory in development mode. On Ubuntu, source
checkout PDF preview may remain unavailable even when the package is installed,
because the package security profile applies only to its packaged launcher.
Run /usr/bin/kukni --check to check the installed package explicitly.
"""


def _checkout_version(project_root: Path) -> str:
    """Return a traceable source revision, while preserving packaged VERSION."""

    version = (project_root / "VERSION").read_text().strip()
    if not (project_root / ".git").exists():
        return version

    git = Path("/usr/bin/git")
    if not git.is_file():
        return f"{version} (development checkout)"
    try:
        count = subprocess.check_output(
            [git, "rev-list", "--count", "HEAD"],
            cwd=project_root,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
        ).strip()
        revision = subprocess.check_output(
            [git, "rev-parse", "--short=12", "HEAD"],
            cwd=project_root,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
        ).strip()
        # @why Source files run in place, so identifying an edited checkout as
        # the clean commit would be misleading. The bounded probe never lists
        # user file names in launcher output.
        tracked_clean = subprocess.run(
            [git, "diff-index", "--quiet", "HEAD", "--"],
            cwd=project_root,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        ).returncode == 0
        untracked_runtime = subprocess.check_output(
            [
                git,
                "ls-files",
                "--others",
                "--exclude-standard",
                "--",
                "bin",
                "src",
                "helpers",
            ],
            cwd=project_root,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
        )
        dirty = "" if tracked_clean and not untracked_runtime else "+dirty"
        return f"{version}~alpha.{count}+g{revision}{dirty} (development checkout)"
    except (OSError, subprocess.SubprocessError):
        return f"{version} (development checkout)"


def _application_main(argv: list[str], *, development: bool) -> int:
    from kukni.application import main

    return main(argv, development=development)


def _diagnostics_main() -> int:
    from kukni.diagnostics import main

    return main()


def _ui_diagnostics_main() -> int:
    try:
        from kukni.ui_diagnostics import main

        return main()
    except Exception:
        # Diagnostics output is a fixed CI contract. Never expose raw WebKit,
        # display, filesystem, or environment details from startup failures.
        print("HTML rendering self-test: Failed (startup)")
        return 1


def main(
    argv: list[str] | None = None,
    *,
    environ: Mapping[str, str] | None = None,
) -> int:
    arguments = list(sys.argv if argv is None else argv)
    environment = os.environ if environ is None else environ
    options = arguments[1:]

    if options in (["-h"], ["--help"]):
        print(_USAGE, end="")
        return 0
    if options == ["--check"]:
        return _diagnostics_main()
    if options == ["--check-html"]:
        return _ui_diagnostics_main()
    if options == ["--version"]:
        print("Kukni " + _checkout_version(PROJECT_ROOT))
        return 0

    development = bool(options and options[0] == "--development")
    if development:
        options = options[1:]
        if options in (["-h"], ["--help"]):
            print(_USAGE, end="")
            return 0
        # @constraint GNU Make percent-encodes raw FILE before exporting it
        # rather than interpolating it into a shell recipe. Decode only the two
        # escapes Make creates; quotes/newlines remain literal shell-free data.
        encoded_make_file = environment.get(_MAKE_DEVELOPMENT_FILE, "")
        make_file = encoded_make_file.replace("%24", "$").replace("%25", "%")
        if make_file:
            if options:
                print("kukni: development file supplied twice", file=sys.stderr)
                return 2
            options = [make_file]
        if len(options) > 1:
            print("kukni: --development accepts at most one FILE", file=sys.stderr)
            return 2
        # End option parsing before FILE so a valid filename beginning with a
        # dash cannot become a GApplication service/control flag.
        arguments = [arguments[0], "--", *options] if options else [arguments[0]]

    return _application_main(arguments, development=development)


if __name__ == "__main__":
    raise SystemExit(main())
